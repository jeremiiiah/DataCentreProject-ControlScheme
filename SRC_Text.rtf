        with pc1: st.line_chart(data=chart_data, x="Time (s)", y=["Rack Temp (\'b0C)", "IT Load (kW)"])\
        with pc2: st.line_chart(data=chart_data, x="Time (s)", y=["Liquid Flow (kg/s)", "Air Flow (kg/s)"])\
\
    # --- TELEMETRY LOG ---\
    with st.expander("\uc0\u55357 \u56540  View Raw Telemetry History"):\
