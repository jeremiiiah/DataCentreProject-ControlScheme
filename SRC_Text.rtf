        with st.expander("\uc0\u55357 \u56504  Economic Factors"):\
            st.session_state.price_standard = st.slider("Standard Grid Price (\'80/kWh)", 0.05, 0.80, float(st.session_state.price_standard))\
            st.session_state.price_adjusted = st.slider("Test Price (\'80/kWh)", 0.05, 1.00, float(st.session_state.price_adjusted))\
\
        st.markdown("---")\
        st.subheader("Quick Disturbances")\
        c1, c2 = st.columns(2)\
